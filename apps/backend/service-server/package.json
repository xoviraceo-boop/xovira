{
  "name": "service-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n server,worker -c green,cyan \"tsx watch src/index.ts\" \"tsx watch src/workers/index.ts\"",
    "dev:worker": "tsx watch src/workers/index.ts",
    "prebuild": "pnpm --filter @xovira/types build",
    "build": "tsc && tsc-alias -p tsconfig.json",
    "start": "node dist/index.js",
    "start:worker": "node dist/workers/index.js",
    "start:all": "node scripts/run-server-and-worker.js",
    "postbuild": "node scripts/fix-esm-imports.cjs",
    "clean": "rm -rf dist node_modules",
    "pretype-check": "pnpm --filter @xovira/types build",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@nestjs/common": "^10.3.0",
    "@nestjs/core": "^10.3.0",
    "@nestjs/platform-express": "^10.3.0",
    "@socket.io/redis-adapter": "^8.2.1",
    "@supabase/supabase-js": "^2.39.0",
    "@xovira/database": "workspace:*",
    "@xovira/types": "workspace:*",
    "@types/node": "^20.10.6",
    "@langchain/langgraph": "^0.2.0",
    "bullmq": "^5.63.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.21.2",
    "inngest": "^3.48.0",
    "ioredis": "^5.3.2",
    "js-tiktoken": "^1.0.21",
    "jsonwebtoken": "^9.0.2",
    "langchain": "^0.3.0",
    "node-cron": "^3.0.3",
    "nodemailer": "^6.10.1",
    "openai": "^4.104.0",
    "pg": "^8.11.3",
    "reflect-metadata": "^0.2.1",
    "rxjs": "^7.8.1",
    "socket.io": "^4.6.1",
    "tsconfig-paths": "^4.2.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.25",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^7.0.3",
    "@types/pg": "^8.10.9",
    "tsc-alias": "^1.8.16",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  }
}